# PostgreSQL connection string (PostGIS must be enabled)
#
# Local (Postgres.app / Homebrew):
# DATABASE_URL="postgresql://USER@localhost:5432/hanchi?schema=public"
#
# Supabase — prefer Session pooler if direct db.* host is IPv6-only / unreachable:
#   Connect → Session mode → URI (port 5432)
#   User format: postgres.<PROJECT_REF>
#   Host: aws-0-<REGION>.pooler.supabase.com
# Escape `$` in passwords as %24. Prefer:
# DATABASE_URL='postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true'
#
# Avoid transaction pooler port 6543 for Prisma Migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Railway sets PORT automatically in production — do not hardcode there
PORT=3000

# Supabase Auth (required in production)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Prefer secret/service role key for server-side token verification
SUPABASE_SECRET_KEY=
# Optional JWKS URL (documentation / future JWT verify path)
# SUPABASE_JWKS_URL="https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json"

# One-time: claim seed-user stamps/favorites when these emails sign up
# SEED_USER_ID="seed-user-1"
# SEED_USER_CLAIM_EMAILS="explorer@hanchi.app,you@example.com"

# Local/dev only — NEVER set these on Railway
# ALLOW_STUB_AUTH=1
# DEV_DEFAULT_USER_ID="seed-user-1"

# Yelp Fusion API key (server-side only)
YELP_API_KEY=

# Protects POST /admin/sync/yelp* — send as header x-sync-secret
SYNC_SECRET=change-me
