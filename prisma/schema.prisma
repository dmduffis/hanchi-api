generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum RouteType {
  curated
  ai_generated
  seasonal
}

enum FavoriteType {
  community
  restaurant
  dish
}

enum CollectionVisibility {
  private
  public
}

enum MediaPurpose {
  moment
  avatar
}

enum MediaStatus {
  pending
  approved
  rejected
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  displayName       String
  /// Moderated public avatar URL (null = initials in clients).
  avatarUrl         String?
  /// Zero or more of: explore | home | learn | bite
  intents           String[]           @default([])
  /// 1–2 ISO country codes the user feels at home with (e.g. ["kr","mx"]).
  cultures          String[]           @default([])
  createdAt         DateTime           @default(now())
  stamps            Stamp[]
  journal           JournalEntry[]
  favorites         Favorite[]
  collections       Collection[]
  collectionFollows CollectionFollow[]
  mediaAssets       MediaAsset[]
}

/// User-uploaded photo after validation + content moderation.
model MediaAsset {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        MediaPurpose
  status         MediaStatus  @default(pending)
  storageKey     String?
  publicUrl      String?
  mimeType       String?
  byteSize       Int?
  moderationJson Json?
  createdAt      DateTime     @default(now())

  @@index([userId, status])
  @@index([userId, purpose])
}

model Community {
  id           String                                  @id @default(cuid())
  name         String
  neighborhood String
  city         String
  description  String
  /// PostGIS polygon (WGS84). Queried via raw SQL / ST_* helpers.
  boundary     Unsupported("geometry(Polygon, 4326)")?
  heroEmoji    String?
  imageUrl     String?
  pois         Poi[]
  stamps       Stamp[]
  journal      JournalEntry[]

  @@index([name])
}

model Poi {
  id          String                                @id @default(cuid())
  /// Null when discovered via metro/cuisine sync outside an enclave.
  communityId String?
  community   Community?                            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  category    String
  /// PostGIS point (WGS84). Queried via raw SQL / ST_* helpers.
  location    Unsupported("geometry(Point, 4326)")?
  address     String?
  hours       String?
  /// Yelp Fusion business id — used for upserts when syncing.
  yelpId      String?                               @unique
  rating      Float?
  priceLevel  String?
  imageUrl    String?
  yelpUrl     String?
  /// 1–2 ethnicity ids for the restaurant itself (not the enclave).
  /// e.g. ["korean"], ["russian","ukrainian"]. Flags are mapped on clients.
  ethnicities String[]                              @default([])
  dishes      Dish[]
  journal     JournalEntry[]
  routeStops  RouteStop[]

  @@index([communityId])
  @@index([name])
}

model Dish {
  id          String  @id @default(cuid())
  poiId       String
  poi         Poi     @relation(fields: [poiId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceRange  String?
  /// Optional dish photo (Unsplash / curated URL).
  imageUrl    String?

  @@index([poiId])
  @@index([name])
}

model Stamp {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  earnedAt    DateTime  @default(now())

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FavoriteType
  /// communityId | poiId | dishId depending on type
  targetId  String
  createdAt DateTime     @default(now())

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([type, targetId])
}

/// Named list of saved places/dishes (Yelp-style Collection).
model Collection {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  visibility  CollectionVisibility @default(private)
  /// Exactly one default "Saved" list per user (enforced in app).
  isDefault   Boolean              @default(false)
  /// Opaque share token — private lists are still open via slug.
  shareSlug   String               @unique @default(cuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       CollectionItem[]
  followers   CollectionFollow[]

  @@index([userId])
  @@index([visibility])
}

model CollectionItem {
  id           String       @id @default(cuid())
  collectionId String
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  type         FavoriteType
  targetId     String
  note         String?
  createdAt    DateTime     @default(now())

  @@unique([collectionId, type, targetId])
  @@index([collectionId])
  @@index([type, targetId])
}

model CollectionFollow {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, collectionId])
  @@index([userId])
  @@index([collectionId])
}

model JournalEntry {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  poiId       String?
  poi         Poi?       @relation(fields: [poiId], references: [id], onDelete: SetNull)
  note        String
  /// First photo (convenience / legacy). Prefer photoUrls.
  photoUrl    String?
  /// Moderated public photo URLs (1–6).
  photoUrls   String[]   @default([])
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([communityId])
  @@index([poiId])
}

model Route {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        RouteType
  createdAt   DateTime    @default(now())
  stops       RouteStop[]

  @@index([type])
}

model RouteStop {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  poiId   String
  poi     Poi    @relation(fields: [poiId], references: [id], onDelete: Cascade)
  order   Int

  @@unique([routeId, order])
  @@index([routeId])
  @@index([poiId])
}
