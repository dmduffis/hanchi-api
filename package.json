{
  "name": "hanchi-api",
  "version": "0.1.0",
  "private": true,
  "description": "Hanchi cultural-discovery API — communities, stamps, journal, and routes",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "yelp:sync": "tsx scripts/sync-yelp.ts",
    "yelp:sync-missing": "tsx scripts/sync-yelp-missing-food.ts",
    "yelp:resync-all": "tsx scripts/resync-yelp-all.ts",
    "communities:add-li": "tsx scripts/add-long-island-communities.ts",
    "communities:add-detroit": "tsx scripts/add-detroit-communities.ts",
    "communities:widen-all": "tsx scripts/widen-all-boundaries.ts",
    "communities:add-la": "tsx scripts/add-la-communities.ts",
    "communities:add-sf": "tsx scripts/add-sf-communities.ts",
    "communities:add-chicago": "tsx scripts/add-chicago-communities.ts",
    "communities:add-five-metros": "tsx scripts/add-five-metros.ts",
    "communities:resync-five-metros": "tsx scripts/resync-five-metros.ts",
    "communities:resync-ct-fl-mn": "tsx scripts/resync-ct-fl-mn.ts",
    "communities:resync-nyc": "tsx scripts/resync-nyc.ts",
    "communities:daily-wiki-yelp": "tsx scripts/daily-wiki-yelp-sync.ts",
    "communities:cleanup-wiki": "tsx scripts/cleanup-wiki-communities.ts",
    "communities:dedupe-wiki": "tsx scripts/dedupe-near-duplicate-communities.ts",
    "communities:rebuild-ridgewood-serbia": "tsx scripts/rebuild-ridgewood-serbia.ts",
    "communities:rebuild-sunnyside-romania": "tsx scripts/rebuild-sunnyside-romania.ts",
    "communities:rebuild-excelsior-sf": "tsx scripts/rebuild-excelsior-sf.ts",
    "communities:rebuild-little-albania": "tsx scripts/rebuild-little-albania.ts",
    "communities:clear-boilerplate-descriptions": "tsx scripts/clear-boilerplate-descriptions.ts",
    "communities:add-ct": "tsx scripts/add-connecticut-communities.ts",
    "communities:add-florida": "tsx scripts/add-florida-communities.ts",
    "communities:add-minnesota": "tsx scripts/add-minnesota-communities.ts",
    "communities:parse-wikipedia": "tsx scripts/parse-wikipedia-enclaves.ts",
    "communities:geocode-wikipedia": "tsx scripts/geocode-wikipedia-enclaves.ts",
    "communities:complete-wikipedia-geocode": "tsx scripts/complete-wikipedia-geocode.ts",
    "communities:generate-wikipedia-meta": "tsx scripts/generate-wikipedia-meta.ts",
    "communities:add-wikipedia": "tsx scripts/add-wikipedia-enclaves.ts",
    "communities:restore-curated": "tsx scripts/restore-curated-community-boundaries.ts",
    "communities:fix-city-centroids": "tsx scripts/fix-city-centroid-boundaries.ts",
    "yelp:metro": "tsx scripts/sync-yelp-metro.ts",
    "dishes:upsert": "tsx scripts/upsert-seed-dishes.ts",
    "dishes:images": "tsx scripts/set-dish-images.ts"
